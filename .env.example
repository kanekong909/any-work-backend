# =============================================
# NexoAdmin Backend - Variables de Entorno
# =============================================
# Copia este archivo a .env y completa los valores

# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- Base de Datos (Railway PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host:5432/nexoadmin
DB_SCHEMA_DEFAULT=public

# --- JWT ---
JWT_SECRET=cambia_esto_por_una_clave_muy_segura_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=otra_clave_secreta_para_refresh_tokens
JWT_REFRESH_EXPIRES_IN=7d

# --- Superadmin (tu usuario) ---
SUPERADMIN_EMAIL=tu@email.com
SUPERADMIN_PASSWORD=password_muy_seguro

# --- Nequi / Pagos manuales ---
NEQUI_NUMBER=3001234567
BANK_ACCOUNT_INFO="Bancolombia · CC 123456789 · Tu Nombre"
WHATSAPP_SUPPORT=573001234567

# --- Email (opcional, para notificaciones) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASS=app_password_de_gmail
EMAIL_FROM="NexoAdmin <noreply@nexoadmin.co>"

# --- CORS ---
FRONTEND_URL=http://localhost:4200
